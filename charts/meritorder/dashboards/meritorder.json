     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (reason) (rate(meritorder_rejected_requests_total[$__rate_interval]))",
     "legendFormat": "refused: {{reason}}",
     "refId": "B",
     "range": true
    }
   ],
   "gridPos": {
    "x": 16,
    "y": 15,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {

{
 "title": "Merit Order",
 "uid": "meritorder",
 "tags": [
  "meritorder",
  "llm"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "description": "Spend, savings, traffic, latency, and GPUs from Merit Order's /metrics.",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0,
    "refresh": 1
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "links": [],
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Spend and savings",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Spend",
   "description": "What is being spent per hour right now: requests on APIs, plus what running GPU replicas cost, idle or busy.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "(sum(rate(meritorder_cost_usd_total{kind!=\"gpu_share\"}[$__rate_interval])) or vector(0)) * 3600 + (sum(max by (backend) (meritorder_gpu_usd_per_hour)) or vector(0))",
     "legendFormat": "spend",
     "refId": "A",
     "range": true
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Would have cost",
   "description": "The same requests at the baseline model's API price, per hour.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(meritorder_baseline_usd_total[$__rate_interval])) * 3600",
     "legendFormat": "baseline",
     "refId": "A",
     "range": true
    }
   ],
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Saving",
   "description": "What the requests would have cost less what is being spent, GPUs included, as a share of what they would have cost. Negative when GPUs cost more than they save.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "(sum(rate(meritorder_baseline_usd_total[$__rate_interval])) * 3600 - ((sum(rate(meritorder_cost_usd_total{kind!=\"gpu_share\"}[$__rate_interval])) or vector(0)) * 3600 + (sum(max by (backend) (meritorder_gpu_usd_per_hour)) or vector(0)))) / clamp_min(sum(rate(meritorder_baseline_usd_total[$__rate_interval])) * 3600, 1e-9)",
     "legendFormat": "saving",
     "refId": "A",
     "range": true
    }
   ],
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "GPU burn",
   "description": "What running GPU replicas cost per hour (SkyPilot catalog prices).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(max by (backend) (meritorder_gpu_usd_per_hour)) or vector(0)",
     "legendFormat": "GPUs",
     "refId": "A",
     "range": true
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Requests",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "(sum(rate(meritorder_requests_total[$__rate_interval])) or vector(0)) + (sum(rate(meritorder_rejected_requests_total[$__rate_interval])) or vector(0))",
     "legendFormat": "req/s",
     "refId": "A",
     "range": true
    }
   ],
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Errors",
   "description": "Failed requests, including ones refused before reaching a backend.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "((sum(rate(meritorder_requests_total{status!~\"2..\"}[$__rate_interval])) or vector(0)) + (sum(rate(meritorder_rejected_requests_total[$__rate_interval])) or vector(0))) / clamp_min((sum(rate(meritorder_requests_total[$__rate_interval])) or vector(0)) + (sum(rate(meritorder_rejected_requests_total[$__rate_interval])) or vector(0)), 1e-9)",
     "legendFormat": "errors",
     "refId": "A",
     "range": true
    }
   ],
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.02
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Spend by model ($/h)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (model) (rate(meritorder_cost_usd_total[$__rate_interval])) * 3600",
     "legendFormat": "{{model}}",
     "refId": "A",
     "range": true
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 18,
      "showPoints": "never",
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Savings by cause ($/h)",
   "description": "routing: a cheaper model; caching: prompt-cache reads; self_hosting: GPUs instead of APIs, at each request's share of the GPU; GPU time no request paid for: the rest of the GPUs' burn (idle, starting, draining), which comes off self_hosting; compression: tool results shortened by the rules; compression_model: by model-based compression (LLMLingua-2); response_cache: exact repeats served from cache. Live traffic only: batches are in the Batches row below (the worker's meritorder_batch_* counters).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (cause) (rate(meritorder_savings_usd_total[$__rate_interval])) * 3600",
     "legendFormat": "{{cause}}",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "(sum(rate(meritorder_cost_usd_total{kind=\"gpu_share\"}[$__rate_interval])) or vector(0)) * 3600 - (sum(max by (backend) (meritorder_gpu_usd_per_hour)) or vector(0))",
     "legendFormat": "GPU time no request paid for",
     "refId": "B",
     "range": true
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 18,
      "showPoints": "never",
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },

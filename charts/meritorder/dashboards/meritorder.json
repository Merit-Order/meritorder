  {
   "id": 13,
   "type": "timeseries",
   "title": "Errors by backend and refusals by reason",
   "description": "Backend failures by backend, and requests refused before a backend: rate_limit_error is budgets and rate limits, overloaded_error is nowhere to run, authentication_error is bad keys.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (backend) (rate(meritorder_requests_total{status!~\"2..\"}[$__rate_interval]))",

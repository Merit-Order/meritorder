  {
   "id": 15,
   "type": "timeseries",
   "title": "Prompt-cache hit ratio",
   "description": "Share of input tokens read from a prompt cache. Stable sessions keep this high.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "(sum(rate(meritorder_tokens_total{kind=\"cache_read\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(meritorder_tokens_total{kind=~\"input|cache_read|cache_write\"}[$__rate_interval])), 1e-9)",
     "legendFormat": "cached share of input",
     "refId": "A",
     "range": true
    }
   ],
   "gridPos": {
    "x": 8,

    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.95, sum by (le, model) (rate(meritorder_time_to_first_token_seconds_bucket[$__rate_interval])))",

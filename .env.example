# Merit Order environment. Copy to .env and fill in what you have; anything left
# blank is simply switched off. Run `uv run meritorder check` to see what's live.

# ---------------------------------------------------------------- gateway
# Admin key for development. Harnesses send it as "Authorization: Bearer <key>" or "x-api-key".
# Make it long and random: openssl rand -hex 24
MERITORDER_DEV_KEY=
# Port the gateway listens on: the host port Docker Compose publishes, and `meritorder serve`'s default.
MERITORDER_PORT=8080
# Docker Compose publishes the gateway on this host address. 127.0.0.1 keeps it on this machine;
# 0.0.0.0 opens it to your network (then use a long dev key, or real keys and sign-in).
MERITORDER_BIND=127.0.0.1
# A second copy of Merit Order on the same machine (another checkout) needs its own Compose project, images and port:
# COMPOSE_PROJECT_NAME=meritorder-2
# MERITORDER_IMAGE=meritorder-2
# Largest request body, in MB (default 32: long agent histories and images can be big).
# MERITORDER_MAX_BODY_MB=32
# Optional: send alerts and weekly digests to a Slack or Teams incoming webhook.
MERITORDER_ALERT_WEBHOOK_URL=
# Optional: require "Authorization: Bearer <token>" on /metrics (it's open otherwise).
MERITORDER_METRICS_TOKEN=
# Encrypts uploaded batch files (OpenAI's /v1/files) until they're handed to the providers, and batch work held for
# self-hosted GPUs. Any long random string (openssl rand -base64 32), the same on every gateway. Without it, uploads are
# refused and batch work skips the GPUs (Anthropic batches to the providers still work). To rotate it, put the old value
# in MERITORDER_BATCH_KEY_PREVIOUS: what it sealed stays readable for batches.key_grace_days.
MERITORDER_BATCH_KEY=
MERITORDER_BATCH_KEY_PREVIOUS=
# The worker serves the batch requests it settles as Prometheus metrics on this port (unset: off).
MERITORDER_WORKER_METRICS_PORT=
# Seals what teams with stored responses keep (the Responses API's previous_response_id and conversations; off unless a
# team turns it on in Config → Teams). Any long random string, the same on every gateway and the worker. To rotate,
# move the old key to MERITORDER_RESPONSES_OLD_KEYS (comma-separated) and set a new one here.
MERITORDER_RESPONSES_KEY=
# MERITORDER_RESPONSES_OLD_KEYS=
# Hard spending caps (docs/06-auth-and-spend.md#organization-wide-safeguards). Blank = no limit.
# The gateway refuses requests (and drains GPUs) as soon as its ledger reaches them.
# All LLM spend per month (e.g. 500), GPU time per month, GPU burn rate per hour, GPU replicas, worst case per request:
MERITORDER_ORG_BUDGET_USD=
MERITORDER_GPU_BUDGET_USD=
MERITORDER_MAX_GPU_USD_PER_HOUR=
MERITORDER_MAX_GPU_REPLICAS=
# MERITORDER_MAX_REQUEST_USD=25

# Scaling (defaults are fine for most installs; see docs/07-deployment.md#performance-and-scaling)
# MERITORDER_WORKERS=1                       # gateway processes per container (needs Postgres and Redis if > 1)
# MERITORDER_UPSTREAM_MAX_CONNECTIONS=500    # per backend, per process
# MERITORDER_REDIS_MAX_CONNECTIONS=200
# MERITORDER_DB_POOL_SIZE=10
# Optional: OpenTelemetry traces (one span per LLM call, GenAI conventions), e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=meritorder-gateway

# ---------------------------------------------------------------- Anthropic (direct)
ANTHROPIC_API_KEY=
# Optional: an Admin API key (sk-ant-admin...) so the worker can check the ledger against Anthropic's cost data.
# Only used when config/meritorder.yaml lists an anthropic bill source (billing.sources; docs/08-reporting.md).
ANTHROPIC_ADMIN_KEY=

# ---------------------------------------------------------------- OpenAI (direct)
OPENAI_API_KEY=
# Optional: an Admin key (sk-admin...) for the organization Costs API, used by an openai bill source.
OPENAI_ADMIN_KEY=

# ---------------------------------------------------------------- OpenRouter (open-weight and Chinese models)
OPENROUTER_API_KEY=
# OpenRouter's free models: rate-limited, and prompts may be logged or used for training. Off unless true.
MERITORDER_ALLOW_FREE_MODELS=false

# ---------------------------------------------------------------- direct vendor APIs (optional)
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
MINIMAX_API_KEY=
XAI_API_KEY=
# The Gemini API (a Google AI Studio key), through Gemini's native generateContent API
GEMINI_API_KEY=

# ---------------------------------------------------------------- Claude in Amazon Bedrock
# Either a Bedrock bearer token (takes priority)...
AWS_BEARER_TOKEN_BEDROCK=
# Set to false while the account can't use the models yet (quotas, model access), so requests don't try it.
MERITORDER_BEDROCK=true
# ...or your normal AWS credentials / profile (run `aws sso login` first for SSO profiles).
AWS_PROFILE=
AWS_REGION=us-east-1

# ---------------------------------------------------------------- Microsoft Foundry / Azure OpenAI
# Resource endpoint, e.g. https://<resource>.services.ai.azure.com (not the /api/projects/... URL)
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
# Set to false until the Claude deployments exist in Foundry.
MERITORDER_FOUNDRY_CLAUDE=true
# Azure OpenAI resource endpoint, e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Your Azure OpenAI deployment name for a GPT model
AZURE_OPENAI_GPT_DEPLOYMENT=
# ...and for an embedding model
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Optional: a SAS token (read and list on the container) for an azure_export bill source whose auth names it
# (auth: {type: api_key, value_env: AZURE_EXPORT_SAS}). Without one, the source uses DefaultAzureCredential.
# AZURE_EXPORT_SAS=

# ---------------------------------------------------------------- Google Vertex AI (Claude and Gemini on Vertex)
# The project ID (lowercase, e.g. my-project), not its display name.
GOOGLE_CLOUD_PROJECT=
# Absolute path to a service-account JSON (no ~: .env doesn't expand it; Docker Compose mounts the file into the
# containers), or leave blank to use `gcloud auth application-default login` outside Docker. Keep it chmod 600.
GOOGLE_APPLICATION_CREDENTIALS=
# Claude on Vertex needs quota for each model (Vertex AI → Model Garden, then a quota increase): until then requests
# get 429 "Quota exceeded" and go to the next route. Set to false to switch Vertex off.
MERITORDER_VERTEX=true
# Also reach Gemini on Vertex through its native generateContent API (backend vertex-gemini-native), not only its
# OpenAI-compatible endpoint. Off until you've tried it on your project.
MERITORDER_VERTEX_GEMINI_NATIVE=false

# ---------------------------------------------------------------- model quality data (optional)
# Quality scores come from published benchmarks (config: quality.source). Epoch AI needs no key. For
# quality.source: artificial_analysis, a free key from https://artificialanalysis.ai/data-api (the console
# credits them, as their terms require).
ARTIFICIAL_ANALYSIS_API_KEY=

# ---------------------------------------------------------------- Entra ID or Google login (optional)
# Entra: issuer https://login.microsoftonline.com/<tenant-id>/v2.0; app registration: public client,
# "Allow public client flows" on, redirect not needed for device code.
# Google: issuer https://accounts.google.com; an OAuth client of type "TVs and Limited Input devices", its
# secret (Google treats it as public for that type), and your Workspace domains (required), comma-separated.
MERITORDER_OIDC_ISSUER=
MERITORDER_OIDC_CLIENT_ID=
MERITORDER_OIDC_CLIENT_SECRET=
MERITORDER_OIDC_HOSTED_DOMAINS=
# Google only: read people's Google Groups for the group mappings (auth.oidc.team_from_groups / role_from_groups, keyed
# by group address). Needs a service account with the Groups Reader admin role. Its JSON key goes on one line below; leave
# it blank on GKE with Workload Identity (docs/06-auth-and-spend.md#google-groups).
MERITORDER_GOOGLE_GROUPS=false
MERITORDER_GOOGLE_GROUPS_CREDENTIALS=
# Entra automatic provisioning (SCIM): a long random secret, also pasted into Entra as the Secret token.
MERITORDER_SCIM_TOKEN=

# ---------------------------------------------------------------- self-hosted GPUs (optional)
# A vLLM/SGLang server you already run (set MERITORDER_LOCAL_VLLM=true to use it).
MERITORDER_LOCAL_VLLM=false
LOCAL_VLLM_URL=
# Let the controller start GPUs with SkyPilot (needs the `sky` CLI and `sky check` passing). The -gpu image has every
# cloud a replica can run on; mount the credentials of the ones you use into the controller (compose.yaml lists them,
# docs/07-deployment.md#skypilot-gpus). SkyPilot copies each one to every replica: give it keys made for this alone.
MERITORDER_SKYPILOT=false
# Where gateways reach the SSH tunnels the controller opens to replicas whose port it can't reach (Vast and Mithril
# always; elsewhere a firewall that drops the port). In Compose: controller. Empty: 127.0.0.1 (all on one machine).
# MERITORDER_TUNNEL_HOST=controller
# SkyPilot's own config (~/.sky/config.yaml), e.g. remote_identity per cloud, when it's mounted elsewhere:
# SKYPILOT_GLOBAL_CONFIG=/home/meritorder/.sky-config/config.yaml
# Hugging Face token for gated model weights when self-hosting.
HF_TOKEN=

# ---------------------------------------------------------------- model-based compression (optional)
# The LLMLingua-2 service for teams with compression.model on (docs/04-caching-and-sessions.md). With Docker Compose,
# `docker compose --profile compressor up -d`, then MERITORDER_COMPRESSOR_URL=http://compressor:8090. Empty: off.
MERITORDER_COMPRESSOR_URL=
# The model the service loads (and the gateways ask for): this, or microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank
# MERITORDER_COMPRESSOR_MODEL=microsoft/llmlingua-2-xlm-roberta-large-meetingbank
# MERITORDER_COMPRESSOR_DEVICE=auto          # cpu, cuda or mps; auto picks a GPU when there is one
# MERITORDER_COMPRESSOR_THREADS=             # CPU threads; default: the container's CPU limit, else torch's own choice
# MERITORDER_COMPRESSOR_KEY=                 # a shared secret: the gateways send it, the service checks it

# ---------------------------------------------------------------- ClickHouse for very large ledgers (optional)
# A copy of the ledger that long-range reports read (docs/08-reporting.md, "Storage and scale"). Postgres stays the record.
# With Docker Compose: `docker compose --profile clickhouse up -d` and MERITORDER_CLICKHOUSE_URL=http://clickhouse:8123.
# Then copy what the ledger already holds: docker compose exec worker meritorder clickhouse backfill
MERITORDER_CLICKHOUSE_URL=
# MERITORDER_CLICKHOUSE_DATABASE=meritorder
# Compose uses (and its clickhouse profile creates) user meritorder with password meritorder unless you set these;
# for a ClickHouse of your own, set its user and password here (a password in the URL is refused).
# MERITORDER_CLICKHOUSE_USER=meritorder
# MERITORDER_CLICKHOUSE_PASSWORD=

# ---------------------------------------------------------------- operations (optional)
# A first admin key, before any user or key exists (remove it once you have one).
# MERITORDER_BOOTSTRAP_ADMIN_KEY=
# Docker Compose's tls profile: the public hostname Caddy gets a certificate for.
# MERITORDER_DOMAIN=gateway.example.com
# The worker runs eval runs started from the console; off to run them only from the CLI.
# MERITORDER_EVAL_RUNS=on
# The learned router's key for hashing words (the same on every gateway and the worker). Unset: one is kept in Postgres.
# MERITORDER_FEATURE_KEY=
# MERITORDER_LOG_LEVEL=INFO
# OpenTelemetry traces (needs the `otel` extra, included in the Docker image).
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://collector:4318/v1/traces
# S3-compatible storage for `meritorder` exports, when not AWS itself (e.g. MinIO, R2).
# MERITORDER_S3_ENDPOINT=
# The `meritorder` CLI's gateway and key (instead of `meritorder login`).
# MERITORDER_URL=http://localhost:8080
# MERITORDER_API_KEY=
# Where people using this gateway get its source (the console's Source link, GET /about). Merit Order is AGPL-3.0:
# running a changed version for others over a network, point this at your version's source.
# MERITORDER_SOURCE_URL=https://github.com/therick/meritorder
